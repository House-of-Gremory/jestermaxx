# Required for Vercel production matchmaking/signaling.
# Create a Redis database at https://console.upstash.com/ and copy these values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: TURN credentials for WebRTC connections across different networks.
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=

# Admin panel login (/admin) — manages the self-hosted TURN server pool.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random secret used to sign admin session cookies. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Cloudflare R2 (S3-compatible) — stores intro reel photos.
# Create a bucket at https://dash.cloudflare.com/ -> R2, then Manage API Tokens
# for an Access Key ID/Secret. Enable Public Access (r2.dev or custom domain)
# on the bucket and put that URL in R2_PUBLIC_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
