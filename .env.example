# Required for Vercel production matchmaking/signaling.
# Create a Redis database at https://console.upstash.com/ and copy these values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: TURN credentials for WebRTC connections across different networks.
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=

# Admin panel login (/admin) — manages the self-hosted TURN server pool.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random secret used to sign admin session cookies. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
